# *************************************************
# 最初にすべての階層のファイルを無視する
# 階層は必要なだけ追加する
# *************************************************

/*
/.**

# *************************************************
# .gitignoreは上から解釈されていくので
# 管理対象をホワイトリストのように追記する
# .zfunc/** ディレクトリは管理したいけど中身はいらない場合
# *************************************************

!/install.zsh
!/Makefile
!/.zshrc
!/.zshenv
!/.zsh/
!/.zsh/alias.zsh
!/.zsh/completion.zsh
!/.zsh/function.zsh
!/.zsh/p10k.zsh
!/.zsh/peco.zsh
!/.config/
!/.config/ghostty/
!/.config/ghostty/config
!/.config/starship.toml
!/.config/starship-cmux.toml
!/.config/yazi/
!/.config/yazi/yazi.toml
!/.config/yazi/keymap.toml
!/.config/yazi/plugins/
!/.config/yazi/plugins/resize-pane.yazi/
!/.config/yazi/plugins/resize-pane.yazi/main.lua
!/README.md
!.gitignore
